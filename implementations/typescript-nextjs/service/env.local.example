# ===========================================
# TypeScript + Next.js 小説投稿サイト
# 環境変数設定ファイル（テンプレート）
# ===========================================
# このファイルを .env.local にコピーして使用してください
# cp env.local.example .env.local

# -------------------------------------------
# アプリケーション基本設定
# -------------------------------------------
NODE_ENV=development

# -------------------------------------------
# ポート設定
# -------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_PORT=5432
REDIS_PORT=6379

# -------------------------------------------
# PostgreSQL設定
# -------------------------------------------
DB_USER=novel_user
DB_PASSWORD=novel_password
DB_NAME=novel_db

# Prisma用 DATABASE_URL
# ローカル開発時はこちらを使用
DATABASE_URL=postgresql://novel_user:novel_password@localhost:5432/novel_db

# Docker環境では docker-compose.yml 内で自動設定されます

# -------------------------------------------
# Redis設定
# -------------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# 認証設定（NextAuth.js）
# -------------------------------------------
# 本番環境では必ず強力なシークレットキーに変更してください
# 生成コマンド: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------
# JWT設定（Backend API）
# -------------------------------------------
# 本番環境では必ず強力なシークレットキーに変更してください
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# -------------------------------------------
# API設定
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# -------------------------------------------
# GraphQL設定（オプション）
# -------------------------------------------
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# -------------------------------------------
# ファイルアップロード設定
# -------------------------------------------
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# -------------------------------------------
# ログ設定
# -------------------------------------------
LOG_LEVEL=debug

# -------------------------------------------
# 本番環境追加設定（デプロイ時に設定）
# -------------------------------------------
# VERCEL_URL=
# NEXT_PUBLIC_VERCEL_URL=

