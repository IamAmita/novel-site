# アプリケーション基本設定
APP_NAME="Novel Site"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# ローカル開発用ポート設定
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_ES_PORT=9200
FORWARD_ES_CLUSTER_PORT=9300

# Docker User Settings (Windows環境で重要)
WWWUSER=1000
WWWGROUP=1000

# データベース設定 (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=novel_site
DB_USERNAME=sail
DB_PASSWORD=password

# ログ設定
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# キャッシュ設定 (Redis使用)
CACHE_STORE=redis
CACHE_PREFIX=novel_site_cache

# セッション設定 (Redis使用)
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# キュー設定 (Redis使用)
QUEUE_CONNECTION=redis

# Redis設定
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Elasticsearch設定 (検索機能)
SCOUT_DRIVER=elasticsearch
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_INDEX=novels

# ファイルストレージ設定
FILESYSTEM_DISK=local

# メール設定 (ローカル開発では無効)
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS設定 (本番環境でのS3移行時に使用、ローカルでは不要)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher設定 (リアルタイム機能、ローカルでは不要)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# 小説サイト固有設定
NOVEL_MAX_FILE_SIZE=10240
NOVEL_ALLOWED_IMAGE_TYPES=jpeg,jpg,png,gif,webp
NOVEL_THUMBNAIL_WIDTH=400
NOVEL_THUMBNAIL_HEIGHT=400
